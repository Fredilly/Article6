# Cloudflare R2 — Document Submission Storage
# Bucket: article6-document-submissions (private)
#
# 1. Get your Account ID from the Cloudflare dashboard
# 2. Create an R2 API token with read/write access to article6-document-submissions
# 3. Copy the Access Key ID and Secret Access Key

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=article6-document-submissions

# Resend — Email notifications for PDD submissions
# 1. Sign up at https://resend.com
# 2. Verify your sending domain (article6.org)
# 3. Create an API key at https://resend.com/api-keys

RESEND_API_KEY=
SUBMISSION_FROM_EMAIL=submissions@article6.org
ADMIN_NOTIFICATION_EMAIL=contact@article6.org
INTERNAL_APP_URL=https://article6.org

# PostgreSQL — durable application state for submissions and internal CRM
POSTGRES_URL=

# CRM disaster recovery — Neon production project and API access
# NEON_PROJECT_ID is not secret. NEON_API_KEY must remain server/local only.
NEON_PROJECT_ID=mute-pine-29238261
NEON_API_KEY=

# Server-to-server Quick Check extraction bridge (server-only)
APP_ARTICLE6_PROCESSOR_URL=
APP_ARTICLE6_PROCESSOR_SECRET=
APP_ARTICLE6_PROCESSOR_TIMEOUT_MS=180000

# Internal admin protection (server-only; never use NEXT_PUBLIC_* names)
# Admin credentials retain the existing access to /internal/* and mutation endpoints.
INTERNAL_UPLOAD_USERNAME=
INTERNAL_UPLOAD_PASSWORD=

# Read-only sales agent protection (server-only)
# Restricted in middleware to GET/HEAD/OPTIONS under /internal/sales only.
# The agent credential is never issued the admin internal-session cookie used by mutation APIs.
INTERNAL_SALES_AGENT_USERNAME=
INTERNAL_SALES_AGENT_PASSWORD=

# Google Sheets (existing, for leaderboard)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Leaderboard
LEADERBOARD_CACHE_TTL=300
